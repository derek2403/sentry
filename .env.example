# Numbers stay blank until you supply them. Use consenting teammates only.
EMERGENCY_CONTACT_PHONE=
DEMO_ESCALATION_PHONE=
APPROVED_DEMO_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS tunnel pointing to local port 5050. No trailing path.
PUBLIC_BASE_URL=
# Nemotron on your DGX Spark; include /v1. Blank endpoint/model = fixed replies only.
# Example: http://<spark-lan-ip>:8000/v1 (use the existing inference service)
LLM_BASE_URL=
LLM_MODEL=
# Leave blank if the local inference service does not require authentication.
LLM_API_KEY=

# Copy to .env.local and adjust. Never commit .env.local.

# Local inference endpoint on the ATOM (vLLM, OpenAI-compatible).
# On the ACE 2026 ATOMs the vision model is Nemotron 3 Nano Omni ("omni") on port 9001;
# "lightning" (9000) and "nano" (9006) are text-only and can't analyse frames.
LLM_BASE_URL=http://localhost:9001/v1
# Nemotron model ID from `curl $LLM_BASE_URL/models`. Leave empty to use the first served model.
LLM_MODEL=omni
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=300
# Ask reasoning-capable Nemotron models to skip thinking, for faster per-frame answers.
LLM_DISABLE_THINKING=true
# Use vLLM guided decoding so replies are always valid JSON (falls back automatically if unsupported).
LLM_JSON_SCHEMA=true

# Frame sampling
ANALYSIS_INTERVAL_S=0.5
FRAME_MAX_WIDTH=768
HOLD_LAST_FRAME_S=8

# Fall confirmation
FALL_CONFIRM_FRAMES=2
FALL_CONFIRM_SECONDS=2
FALL_RECOVER_FRAMES=2
FALL_MIN_CONFIDENCE=0.5
FALL_CANDIDATE_TIMEOUT_S=10

CAMERA_NAME=Living room
DATA_DIR=data

# Copy to .env and fill in. Never commit .env or .env.local.
# The dashboard (Next.js) reads .env and .env.local; the call service (python -m sentry_calls) reads .env.

# ---------- Nemotron on the ATOM ----------
# Local inference endpoint (vLLM, OpenAI-compatible). On the ACE 2026 ATOMs the vision model is
# Nemotron 3 Nano Omni ("omni") on port 9001; "lightning" (9000) and "nano" (9006) are text-only.
# From a laptop, tunnel it first: ssh -N -L 9001:127.0.0.1:9001 DGX-Spark
LLM_BASE_URL=http://localhost:9001/v1
# Model ID from `curl $LLM_BASE_URL/models`. Empty = first served model.
LLM_MODEL=omni
# Leave blank if the endpoint has no key.
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=300
# Ask reasoning-capable Nemotron models to skip thinking, for faster per-frame answers.
LLM_DISABLE_THINKING=true
# Use vLLM guided decoding so replies are always valid JSON (falls back automatically if unsupported).
LLM_JSON_SCHEMA=true

# ---------- Frame-by-frame fall detection ----------
ANALYSIS_INTERVAL_S=0.5
FRAME_MAX_WIDTH=768
HOLD_LAST_FRAME_S=8
FALL_CONFIRM_FRAMES=2
FALL_CONFIRM_SECONDS=2
FALL_RECOVER_FRAMES=2
FALL_MIN_CONFIDENCE=0.5
FALL_CANDIDATE_TIMEOUT_S=10
DATA_DIR=data

# ---------- Emergency call when a fall is confirmed ----------
# on = real call through sentry_calls, simulate = print the script only, off = no call.
EMERGENCY_CALLS=off
# Wait this many seconds first; Mark OK on the dashboard cancels the call. 0 = call straight away.
EMERGENCY_CALL_DELAY_S=0
# Python with requirements-calls.txt installed (default: .venv/bin/python, then python3).
CALLS_PYTHON=

# ---------- Call service (sentry_calls, see CALLS.md) ----------
# Numbers stay blank until you supply them. Use consenting teammates only.
EMERGENCY_CONTACT_PHONE=
DEMO_ESCALATION_PHONE=
APPROVED_DEMO_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS tunnel pointing to local port 5050. No trailing path.
PUBLIC_BASE_URL=
